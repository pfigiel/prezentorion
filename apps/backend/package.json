{
  "name": "@prezentorion/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/main.ts",
    "dev:local": "tsx watch --env-file=.env.stack src/main.ts",
    "stack:start": "node scripts/start-stack.ts",
    "stack:seed": "node scripts/seed-stack.ts",
    "build": "esbuild src/app.ts --bundle --format=esm --platform=neutral --minify --outfile=supabase/functions/api/app.js",
    "config:push": "supabase config push",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy api --use-api",
    "lint": "eslint .",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.119.0",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@prezentorion/eslint-config": "workspace:*",
    "@prezentorion/tsconfig": "workspace:*",
    "@hono/node-server": "2.1.8",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}

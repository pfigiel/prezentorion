{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // Starts its own servers against the local Supabase stack, and its result depends on that stack.
    "e2e": {
      "cache": false
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    // No package defines it: it runs nothing, and only makes a task's cache key cover what its dependencies contain.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "type:check": {
      "dependsOn": ["transit"]
    }
  }
}
